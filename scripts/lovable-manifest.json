{
  "$docs": "Contrato Lovable → km0lab-backoffice. Ver docs/SYNC-FROM-LOVABLE.md. include: globs relativos al repo Lovable. exclude: nunca se copian. locked: destinos de producto (API real, env, auth, mappers, types wire); el sync se niega a sobrescribirlos. Un path acabado en / bloquea el directorio entero. Al conectar un service real a km0lab-api, añádelo a locked en el mismo commit.",
  "sourceRepo": "KM0Lab-git-admin/km0lab-backoffice-lovable",
  "sourceRef": "main",
  "defaultSourceDir": "../km0lab-backoffice-lovable",
  "include": [
    "src/components/**",
    "src/pages/**",
    "src/routes/**",
    "src/services/**",
    "src/stores/**",
    "src/data/**",
    "src/hooks/**",
    "src/contexts/**",
    "src/types/**",
    "src/lib/**",
    "src/styles.css",
    "src/router.tsx",
    "src/server.ts",
    "src/start.ts",
    "src/routeTree.gen.ts",
    "public/**",
    "components.json"
  ],
  "exclude": [
    "src/lib/lovable-error-reporting.ts",
    ".lovable/**",
    "src/integrations/**",
    "supabase/**",
    "src/stores/useAdminBescanvisStore.ts",
    "src/stores/useAdminPagamentsStore.ts"
  ],
  "locked": [
    "src/lib/env.ts",
    "src/lib/apiClient.ts",
    "src/services/accionsService.ts",
    "src/services/adminComercosService.ts",
    "src/services/adminService.ts",
    "src/services/authService.ts",
    "src/services/bescanvisService.ts",
    "src/services/comercService.ts",
    "src/services/configService.ts",
    "src/services/fitxaService.ts",
    "src/services/pagamentsService.ts",
    "src/services/promocionsService.ts",
    "src/services/qrService.ts",
    "src/services/recompensesService.ts",
    "src/services/statsService.ts",
    "src/services/usuarisService.ts",
    "src/services/valsComercService.ts",
    "src/lib/mappers/admin.ts",
    "src/lib/mappers/promocio.ts",
    "src/lib/mappers/shop.ts",
    "src/lib/mappers/categories.ts",
    "src/lib/mappers/horari.ts",
    "src/types/api.ts",
    "src/types/comerc.ts",
    "src/stores/useAuthStore.ts",
    "src/stores/useSessionStore.ts",
    ".env",
    ".env.local",
    ".env.development",
    ".env.production"
  ]
}
